+    def scale_block_glyphs(self):
+        """ DF: grow box drawing and block elements past the cell so they overlap
+
+        Ported from romkatv/nerd-fonts, but run after all patch sets have been
+        copied rather than before: the Bold source faces carry no box drawing of
+        their own, so for them these glyphs only exist once upstream's Box
+        Drawing set has been pasted in. Running last means all four faces end up
+        with the same geometry whichever way they got their glyphs.
+
+        U+2588 FULL BLOCK is scaled to
+        DF_BLOCK_SCALE_X/Y of the cell and shifted by DF_BLOCK_OFFSET_X/Y, and
+        the resulting transform is applied to the whole U+2500..U+259F range so
+        the box drawing pieces stay mutually aligned. The advance width is left
+        at exactly one cell, so the extra size shows up as overhang that closes
+        the seams between horizontally and vertically adjacent cells.
+        """
+        if DF_BLOCK_REFERENCE not in self.sourceFont:
+            logger.warning("DF: no U+%04X in source font, not scaling block glyphs", DF_BLOCK_REFERENCE)
+            return
+        for _ in range(DF_BLOCK_PASSES):
+            sym = self.sourceFont[DF_BLOCK_REFERENCE]
+            sym_dim = get_glyph_dimensions(sym)
+            if not sym_dim['width'] or not sym_dim['height']:
+                logger.warning("DF: U+%04X is empty, not scaling block glyphs", DF_BLOCK_REFERENCE)
+                return
+            scale = psMat.scale(
+                DF_BLOCK_SCALE_X * self.font_dim['width'] / sym_dim['width'],
+                DF_BLOCK_SCALE_Y * self.font_dim['height'] / sym_dim['height'])
+            sym.transform(scale)
+            sym_dim = get_glyph_dimensions(sym)
+            translate = psMat.translate(
+                self.font_dim['xmin'] - sym_dim['xmin'] - DF_BLOCK_OFFSET_X * self.font_dim['width'],
+                self.font_dim['ymin'] - sym_dim['ymin'] - DF_BLOCK_OFFSET_Y * self.font_dim['height'])
+            sym.transform(translate)
+            mat = psMat.compose(scale, translate)
+
+            for codepoint in DF_BLOCK_RANGE:
+                try:
+                    sym = self.sourceFont[codepoint]
+                except TypeError:
+                    continue
+                if codepoint != DF_BLOCK_REFERENCE:
+                    sym.transform(mat)
+                sym.width = self.font_dim['width']
+
+
