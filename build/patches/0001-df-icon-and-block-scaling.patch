+# --- dotfiles.fonts ("DF") deviations from stock Nerd Fonts -------------------
+#
+# Ported from romkatv/nerd-fonts, the fork that produced the original
+# "MesloLGS NF" that powerlevel10k recommends. Both deviations exist because
+# stock Nerd Fonts optimises for "icon fits inside the cell", while a prompt
+# theme optimises for "icons are legible and frames have no seams".
+#
+#   DF_ICON_SCALE       'pa' (preserve-aspect) icons are fitted against this
+#                       multiple of the cell width instead of one cell. Every
+#                       icon then lands in the same bounding box, overhanging
+#                       the cell by ~10% per side. Stock --mono clamps icons to
+#                       exactly one cell, which renders them noticeably smaller.
+#
+#   DF_BLOCK_*          U+2500..U+259F (box drawing + block elements) are scaled
+#                       slightly past the cell and nudged left/down so adjacent
+#                       cells overlap. Without this, the multi-line frames drawn
+#                       by powerlevel10k and tide show hairline gaps at many
+#                       font sizes.
+#
+# Both are gated behind --df so this patcher still builds stock output.
+DF_ICON_SCALE = 1.2
+DF_BLOCK_RANGE = range(0x2500, 0x25A0)
+DF_BLOCK_REFERENCE = 0x2588          # FULL BLOCK, drives the shared transform
+DF_BLOCK_SCALE_X = 1.06
+DF_BLOCK_SCALE_Y = 1.04
+DF_BLOCK_OFFSET_X = 0.03             # fraction of cell width, shifted left
+DF_BLOCK_OFFSET_Y = 0.02             # fraction of cell height, shifted down
+DF_BLOCK_PASSES = 3                  # iterate to converge away rounding error
+# -----------------------------------------------------------------------------
+
